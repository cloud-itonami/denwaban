{:paths ["src"]
 ;; Both dependencies were repointed 2026-07-30 (ADR-2607300300 step 3). The old
 ;; coordinates named repositories that have since moved:
 ;;   com-junkawasaki/koe-clj                     -> kotoba-lang/koe
 ;;   etzhayyim/com-etzhayyim-social-publication  -> kotoba-lang/social-publication
 ;; GitHub still redirects the old URLs, which is exactly why the drift went
 ;; unnoticed. The pinned SHAs are UNCHANGED and were each verified to exist in
 ;; the new repository before the URL was rewritten. social-publication's
 ;; namespace is still etzhayyim.social.publication (verified at this SHA and at
 ;; its HEAD), so denwaban.social's :require is deliberately untouched -- a
 ;; repository rename is not a namespace rename.
 :deps {
        ;; kotoba.http.form-urlencoded replaced java.net.URLEncoder/URLDecoder here
        ;; (2026-09-24). An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/http-parse-url {:git/sha "8ad2f9680111e50168b4078a64601dc9296158d7"}
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json {:git/sha "9c11ad189e64907700e8b4eb9b26f40336bffa01"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/koe
        {:git/url "https://github.com/kotoba-lang/koe.git"
         :git/sha "1ebb0acd0183f7fb16807282e545b6a1e13fe59d"}
        io.github.kotoba-lang/social-publication
        {:git/url "https://github.com/kotoba-lang/social-publication.git"
         :git/sha "e8127d0661284b1c12ce1b216c84b5ed2db619ab"}

        ;; yotei — the 予約 itself (ADR-2608150900). Until now this repository
        ;; named yotei in `manifest.edn` as a contract and never depended on its
        ;; code, which is why booking was a stage label rather than a booking.
        ;; `denwaban.yoyaku` now calls yotei.seat / yotei.delegation directly, so
        ;; the table chosen and the envelope enforced are yotei's own functions
        ;; and not a second copy of them living here.
        io.github.cloud-itonami/yotei
        {:git/url "https://github.com/cloud-itonami/yotei.git"
         :git/sha "e85ae8912be6cfb759e613db3241fb30672c290d"}

        ;; The HTTP surface's JSON codec. com.sun.net.httpserver is JDK-provided, so
        ;; the surface adds no server dependency -- only this.
        org.clojure/data.json {:mvn/version "2.5.1"}

        ;; http-kit — the WebSocket server and client the media stream needs.
        ;; One small jar, no transitive dependencies. It is here and not in
        ;; kotoba-lang/koe on purpose: koe holds the decisions and stays free of
        ;; every SDK, and this actor is where a socket is actually opened.
        http-kit/http-kit {:mvn/version "2.8.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-i" "run_tests.cljk"]}
  ;; kbb -M:serve -> the consent surface (loopback :1343). One listener; see
  ;; denwaban.http's docstring for why there is no operator port.
  :serve {:main-opts ["-m" "denwaban.http"]}
  ;; kbb -M:serifu [dir] [voice]
  ;; -> render the closed set of receptionist lines to ulaw@8000 files. Build
  ;;    time, never call time: synthesis costs 0.65-1.14s and reading a rendered
  ;;    file costs 0.02s (measured 2026-08-15).
  :serifu {:main-opts ["-m" "denwaban.render-serifu"]}
  ;; kbb -M:media [port] -> the live-call sockets (POST /voice, WS /media).
  ;; Needs a speech engine at :engine-url and rendered lines in :serifu-dir.
  :media {:main-opts ["-m" "denwaban.ws"]}}}
