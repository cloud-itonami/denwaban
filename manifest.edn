;; denwaban (電話番) — actor manifest (kotoba-native)
;; Voice receptionist: 着信応対 + 音声対話 + 自動予約。Composes existing actors,
;; delegates booking to yotei (single source of truth). ADR-2606271930.
{:actor/id        "denwaban"
 :actor/glyph     "電話番"
 :actor/tier      :tier-b
 :actor/integrates ["toritsugi" "yadori" "yotei"]
 :actor/domain    "denwaban.etzhayyim.com"
 :actor/purpose   "Voice receptionist — answers an inbound call (PSTN/SIP via twilio-compat, or a WebRTC soft-phone over kotoba-net), converses by voice (STT=whisper-compat, dialog=KotobaLLM, TTS=elevenlabs-compat), and BOOKS by delegating to yotei (no-double-book + member-signed). The telephone/voice counterpart of toritsugi (text/LINE window). Holds no booking state, no buyer-of-record role, no call recording without consent. Murakumo-only."
 :actor/status    :r0
 :actor/adr       "2606271930"

 ;; reusable voice-session kernel lives in com-junkawasaki (shared library),
 ;; not embedded here — denwaban is the etzhayyim public-benefit instance.
 :actor/code-dependencies
 {com.junkawasaki/koe-clj "ceca39b877f3285f4bacbca9270190670b0d5c90"
  com.etzhayyim/social-publication "e8127d0661284b1c12ce1b216c84b5ed2db619ab"}

 :actor/repository-contracts
 {:booking {:repository "https://github.com/etzhayyim/com-etzhayyim-yotei"
            :revision "bf3dac0213197a45a64ea8f566fb61700432672e"
            :port koe.ports/IBooking}
  :webrtc {:repository "https://github.com/kotoba-lang/net"
           :revision "86475deaa761f91435262b7d60861d07c68abdb8"
           :port koe.ports/ITelephony}}

 :actor/unimplemented-port-bindings
 {:twilio-compat {:port koe.ports/ITelephony :state :external-contract}
  :whisper-compat {:port koe.ports/ISTT :state :external-contract}
  :elevenlabs-compat {:port koe.ports/ITTS :state :external-contract}}

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1" :gate/name "consent-first"        :gate/rule "no secret recording; call recording/transcript retention requires explicit up-front consent; transient by default"}
  {:gate/id "G2" :gate/name "member-signed-booking":gate/rule "every booking is confirmed through yotei's member-signed confirm (G5/G8 of yotei); denwaban never confirms server-side"}
  {:gate/id "G3" :gate/name "no-booker-harvest"    :gate/rule "no caller profiling / resale / CRM funnel; phone handles minimal, encrypted, used only to hold the slot (inherits yotei G2)"}
  {:gate/id "G4" :gate/name "murakumo-only"        :gate/rule "STT/dialog/TTS run in Murakumo; KotobaLLM 127.0.0.1:4000; no passthrough to external SaaS"}
  {:gate/id "G5" :gate/name "no-server-key"        :gate/rule "telephony/registrar creds member-held; WebRTC TURN via kotoba-turn short-lived credential (ADR-2606271800); no server key emitted"}
  {:gate/id "G6" :gate/name "no-robocall"          :gate/rule "no untargeted outbound dialing / autodialer / caller-ID spoofing; outbound limited to consented callbacks"}
  {:gate/id "G7" :gate/name "outward-gated"        :gate/rule "live inbound/outbound telephony is R0=offline + intent only; live = Council Lv6+ + operator gate + explicit env flag"}
  {:gate/id "G8" :gate/name "sourcing-honesty"     :gate/rule "transcripts/bookings use representative fixtures with provenance; no fabricated call data"}]

 ;; cells = the session pipeline (telephony → listen → converse → speak → book)
 :actor/cells
 [{:cell/id "ingress"  :cell/kind :coded     :cell/runtime :kotoba :cell/doc "twilio-compat Programmable Voice / SIP / WebRTC soft-phone ingress (G7-gated)"}
  {:cell/id "listen"   :cell/kind :coded     :cell/runtime :wasm   :cell/doc "STT via whisper-compat; streaming partials for barge-in"}
  {:cell/id "converse" :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "KotobaLLM dialog loop; intent + slot extraction (G4)"}
  {:cell/id "speak"    :cell/kind :coded     :cell/runtime :wasm   :cell/doc "TTS via elevenlabs-compat; emits voice back over the ingress channel"}
  {:cell/id "book"     :cell/kind :coded     :cell/runtime :kotoba :cell/doc "delegate to yotei BookSlot/SetAvailability via MCP; no local booking state (G2)"}]

 :actor/lexicons
 ["com.etzhayyim.denwaban.session"
  "com.etzhayyim.denwaban.utterance"]

 :actor/siblings
 {:toritsugi "citizen-facing gov-procedure concierge (text/LINE window)"
  :yotei     "Calendly-inverse booking commons (delegation target)"
  :yadori    "reservation state-machine reference pattern"}

 :actor/resources
 {:manifest "manifest.edn"
  :session "src/denwaban/session.cljc"
  :social-state-machine "src/denwaban/cells/social_post/state_machine.cljc"}

 :actor/tests
 {:runner "babashka" :cmd "bb test"
  :verification {:tests 6 :assertions 16 :failures 0 :errors 0}
  :suites ["denwaban.test-session" "denwaban.test-social"]}}
