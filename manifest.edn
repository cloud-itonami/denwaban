;; denwaban (電話番) — actor manifest (kotoba-native)
;; Voice receptionist: 着信応対 + 音声対話 + 自動予約。Composes existing actors,
;; delegates booking to yotei (single source of truth). ADR-2606271930.
{:actor/id        "denwaban"
 :actor/glyph     "電話番"
 :actor/tier      :tier-b
 :actor/integrates ["toritsugi" "yadori" "yotei"]
 :actor/domain    "denwaban.etzhayyim.com"
 :actor/purpose   "Voice receptionist — answers an inbound call through an admitted provider-neutral PSTN/SIP ITelephony adapter, or a WebRTC soft-phone; converses by voice (STT=kotoba-lang/com-whisper, dialog=KotobaLLM, TTS=kotoba-lang/com-elevenlabs); and BOOKS by delegating to cloud-itonami/yotei (no-double-book + member-signed). IP access (terrestrial, cellular eSIM, Starlink) is selected independently and never treated as a telephone provider. The telephone/voice counterpart of toritsugi (text/LINE window). Holds no booking state, no buyer-of-record role, no call recording without consent. Murakumo-only."
 :actor/status    :r0
 :actor/adr       "2606271930"

 ;; A single :actor/status word was hiding a real change, in both directions:
 ;; "R0 scaffold" now understates what runs, and anything above it would claim a
 ;; telephone this actor still cannot answer. Reach is recorded per capability
 ;; instead, so neither half can be read off the other (ADR-2608150900).
 :actor/reach
 {:conversation :implemented    ; denwaban.uketsuke — slot-filling, refusals, escalation
  :booking      :implemented    ; denwaban.yoyaku -> yotei.seat + yotei.delegation, confirmed 予約
  :consent      :implemented    ; denwaban.consent — attested, stamped, never signed
  :telephony    :g7-gated       ; opening a channel: Council Lv6+ + named operator + flag
  :arrival      :implemented    ; denwaban.arrival — forwarded calls, caller-ID provenance
  :webhook-auth :implemented    ; denwaban.carrier — Twilio HMAC-SHA1, known-answer tested
  :extraction   :implemented    ; denwaban.kikitori — deterministic; the model is the FALLBACK
  :tts          :available-unwired ; macOS `say` on every fleet node, ulaw@8000 (measured 2026-08-15)
  :stt          :absent         ; com-whisper is a clean-room stub; infer.murakumo.cloud is completion-only
  :media-bridge :not-implemented
  :locales      #{:ja :en}}     ; dialog + consent sentence; a locale with no sentence refuses

 ;; Reusable voice-session kernel lives in kotoba-lang/koe (shared library), not
 ;; embedded here — denwaban is the public-benefit instance. Repointed 2026-07-30
 ;; (ADR-2607300300 step 3): koe-clj moved to kotoba-lang/koe and the social
 ;; publication membrane to kotoba-lang/social-publication. SHAs are unchanged and
 ;; each was verified present in the new repository first.
 :actor/code-dependencies
 {io.github.kotoba-lang/koe "ceca39b877f3285f4bacbca9270190670b0d5c90"
  io.github.kotoba-lang/social-publication "e8127d0661284b1c12ce1b216c84b5ed2db619ab"
  ;; yotei is a code dependency as of 2026-08-15, not only a contract. Before
  ;; this the repository named yotei in :actor/repository-contracts and called
  ;; none of it, which is why "book" was a stage label rather than a booking.
  io.github.cloud-itonami/yotei "e85ae8912be6cfb759e613db3241fb30672c290d"}

 :actor/repository-contracts
 {:booking {:repository "https://github.com/cloud-itonami/yotei"
            :revision "bf3dac0213197a45a64ea8f566fb61700432672e"
            :port koe.ports/IBooking
            ;; Was etzhayyim/com-etzhayyim-yotei, which now redirects here. NOTE:
            ;; a separate kotoba-lang/yotei repository also exists and is NOT this
            ;; one — it does not contain this revision. Verified before rewriting.
            :repointed "2026-07-30"}
  :webrtc {:repository "https://github.com/kotoba-lang/io-libp2p"
           :revision "86475deaa761f91435262b7d60861d07c68abdb8"
           :port koe.ports/ITelephony
           ;; Was kotoba-lang/net, which now redirects to io-libp2p; this revision
           ;; does live there, so the URL rewrite is a pure rename.
           :repointed "2026-07-30"
           ;; OPEN QUESTION, deliberately not resolved by guessing: a repository
           ;; now named io-libp2p supplying the WebRTC ITelephony transport of
           ;; ADR-2606271800 is surprising, and a separate kotoba-lang/webrtc
           ;; exists which does NOT contain this revision. Whoever takes the
           ;; WebRTC ingress past R0 must settle which repository owns this
           ;; binding; until then this records where the pinned code actually is.
           :review :binding-provenance-unsettled}}

 :actor/unimplemented-port-bindings
 {:telephony-provider {:port koe.ports/ITelephony :state :external-contract
                       :adapters [:twilio :telnyx :vonage :amazon-connect]
                       :access-paths [:terrestrial :cellular-esim :starlink]
                       :failover :new-call-only}
  :com-whisper {:port koe.ports/ISTT :state :external-contract}
  :com-elevenlabs {:port koe.ports/ITTS :state :external-contract}}

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1" :gate/name "consent-first"        :gate/rule "no secret recording; call recording/transcript retention requires explicit up-front consent; transient by default"}
  {:gate/id "G2" :gate/name "member-signed-booking":gate/rule "every booking is confirmed through yotei, never here. 2026-08-15 (ADR-2608150900): the telephone path uses yotei's DELEGATED door — a delegate-origin signature plus a true admission from yotei.delegation, which re-derives the whole 予約 against an envelope the owner signed in advance. denwaban still confirms nothing itself: it signs and asks. The distinction that must survive is that an unattended confirm is bounded by the owner's own sentence and stamped confirmedVia=delegate, so it can never be read as a member sitting down and agreeing to this particular 予約"}
  {:gate/id "G3" :gate/name "no-booker-harvest"    :gate/rule "no caller profiling / resale / CRM funnel; phone handles minimal, encrypted, used only to hold the slot (inherits yotei G2)"}
  {:gate/id "G4" :gate/name "murakumo-only"        :gate/rule "STT/dialog/TTS run in Murakumo; KotobaLLM 127.0.0.1:4000; no passthrough to external SaaS"}
  {:gate/id "G5" :gate/name "no-server-key"        :gate/rule "telephony/registrar creds member-held; WebRTC TURN via kotoba-turn short-lived credential (ADR-2606271800); no server key emitted"}
  {:gate/id "G6" :gate/name "no-robocall"          :gate/rule "no untargeted outbound dialing / autodialer / caller-ID spoofing; outbound limited to consented callbacks"}
  {:gate/id "G7" :gate/name "outward-gated"        :gate/rule "live inbound/outbound telephony is R0=offline + intent only; live = Council Lv6+ + operator gate + explicit env flag"}
  {:gate/id "G8" :gate/name "sourcing-honesty"     :gate/rule "transcripts/bookings use representative fixtures with provenance; no fabricated call data"}
  {:gate/id "G9" :gate/name "consent-attested-not-signed" :gate/rule "a telephone caller has no DID, so their consent is ATTESTED (denwaban.consent) and stamped consentKind on the 予約; it must never be presentable as yotei's member DID-signed consent (G8 there). Attestation carries that consent was given, when, and to which sentence -- never the recording (G1)"}
  {:gate/id "G14" :gate/name "extraction-refuses-rather-than-guesses" :gate/rule "denwaban.kikitori returns nil for any field it cannot read cleanly, and the dialog then ASKS. An absent field costs one more question; a wrong one is a party of six at a two-top or a table held on the wrong evening, discovered on arrival. Party size needs a counter word (a bare 4 is 4番テーブル or 4月), a time with no day is not resolved to today, and 「お願いします」 alone is not consent -- it is how the call opens (2026-08-15)"}
  {:gate/id "G13" :gate/name "unverified-webhook-says-nothing" :gate/rule "an inbound webhook whose signature does not verify is answered with <Hangup/> and no spoken message -- the party at the other end is unknown, so anything said is said to them. A provider whose scheme is not implemented is REFUSED, never admitted unchecked, and the implemented set is DERIVED from the verifier table so it cannot claim more than it can do. The answer document is <Connect><Stream>, never <Start>: Start forks a copy and leaves the call up, which is a listening device (2026-08-15)"}
  {:gate/id "G11" :gate/name "caller-id-has-provenance" :gate/rule "a presented number becomes the caller's contact ONLY when its provenance says so (denwaban.arrival). On a forwarded call -- the first deployment shape -- the presented number may be the SHOP's own line; a number equal to the forwarding line is never the caller whatever the carrier labelled it. A wrong contact is worse than a missing one: it is never asked about, and the 予約 looks well formed while holding a table for someone nobody can reach (2026-08-15)"}
  {:gate/id "G12" :gate/name "consent-in-the-callers-language" :gate/rule "the consent sentence is per locale and the attestation records WHICH sentence was said (consentLocale). A locale with no sentence REFUSES rather than falling back -- attesting that a caller agreed to a sentence never said to them, in a language they may not speak, is an attestation of something that did not happen (2026-08-15)"}
  {:gate/id "G10" :gate/name "unconfirmable-means-callback" :gate/rule "if the owner-signed envelope is expired, or either signature cannot be verified, the call ends with a human callback and the caller is told. Collecting further details is refused -- personal data taken for an act that cannot happen"}]

 ;; cells = the session pipeline (telephony → listen → converse → speak → book)
 :actor/cells
 [{:cell/id "ingress"  :cell/kind :coded     :cell/runtime :kotoba :cell/doc "provider-neutral PSTN/SIP ITelephony adapter or WebRTC soft-phone; IP access selected independently (G7-gated)"}
  {:cell/id "listen"   :cell/kind :coded     :cell/runtime :wasm   :cell/doc "STT via kotoba-lang/com-whisper; streaming partials for barge-in"}
  {:cell/id "converse" :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "KotobaLLM dialog loop; intent + slot extraction (G4)"}
  {:cell/id "speak"    :cell/kind :coded     :cell/runtime :wasm   :cell/doc "TTS via kotoba-lang/com-elevenlabs; emits voice back over the ingress channel"}
  {:cell/id "book"     :cell/kind :coded     :cell/runtime :kotoba :cell/doc "denwaban.yoyaku -> yotei.seat (which table) + yotei.delegation (owner-signed envelope, re-derived) + yotei.yoyaku (no-double-book); no local booking state (G2)"}]

