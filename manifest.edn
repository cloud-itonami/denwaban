 :actor/tests
 {:runner "clojure" :cmd "clojure -M:test"
  :verification {:tests 95 :assertions 284 :failures 0 :errors 0}
  :suites ["denwaban.test-session" "denwaban.test-transport"
           "denwaban.test-social" "denwaban.test-state-machine"
           "denwaban.test-http" "denwaban.test-uketsuke"]
  ;; Verified by mutation rather than asserted: breaking the seating time in
  ;; propose, and fabricating a confirmation instead of delegating, each fail
  ;; the end-to-end call test. Both consent gates were ALSO measured -- and
  ;; separately, because with both in place either one could be removed and the
  ;; suite still passed. They now have a test each.
  :discriminates true}}
